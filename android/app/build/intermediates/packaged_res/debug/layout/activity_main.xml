<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B12"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="🪐 NEXUS SATELLITE"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="24/7 Home Wake-on-LAN &amp; Unlock Relay"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#111728"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="10dp"
                android:background="#F43F5E" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNPAIRED • ENTER PIN"
                android:textColor="#F43F5E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PIN Input Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="6-DIGIT PAIRING PIN FROM PC"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="#0F1524"
            android:gravity="center"
            android:hint="482-190"
            android:inputType="textCapCharacters"
            android:maxLength="7"
            android:textColor="#38BDF8"
            android:textColorHint="#334155"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Connect Button -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="20dp"
            android:background="#0284C7"
            android:text="CONNECT &amp; START 24/7 RELAY"
            android:textColor="#080B12"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Target Info Card -->
        <LinearLayout
            android:id="@+id/cardTargetInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#0E1424"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTargetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: Target-PC"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTargetMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="MAC: 74:56:3C:48:E0:7F"
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTargetIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Local IP: 192.168.100.50"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Test Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestWol"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#10B981"
                android:text="⚡ TEST WOL"
                android:textColor="#080B12"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestUnlock"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#38BDF8"
                android:text="🔓 TEST UNLOCK"
                android:textColor="#080B12"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Nexus Universal Home Satellite v3.2 • Keep phone on Wi-Fi"
            android:textColor="#475569"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
