<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B12"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🪐 NEXUS SATELLITE &amp; LAN SUITE"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Direct LAN Controller &amp; 24/7 Cloud Relay Gateway"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#111728"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="10dp"
                android:background="#F43F5E" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNPAIRED • ENTER PIN"
                android:textColor="#F43F5E"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LAN Auto-Discovery Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#0D1322"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCAL WI-FI DISCOVERY"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnScanLan"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="#0284C7"
                    android:minWidth="90dp"
                    android:text="🔍 SCAN WI-FI"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Discovered PC Result Card -->
            <LinearLayout
                android:id="@+id/cardDiscoveredPc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#131C31"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDiscoveredName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 hajimaPC (Discovered)"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiscoveredIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="IP: 192.168.100.50 • MAC: 74:56:3C:48:E0:7F"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnLinkDiscovered"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="#10B981"
                    android:text="⚡ 1-TAP LINK THIS PC"
                    android:textColor="#080B12"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Target Info Card (When Linked) -->
        <LinearLayout
            android:id="@+id/cardTargetInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#0E1424"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTargetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target: hajimaPC"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUnlink"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#334155"
                    android:minWidth="75dp"
                    android:text="UNLINK"
                    android:textColor="#F43F5E"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="LAN IP: 192.168.100.50:48880"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTargetMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Target MAC: 74:56:3C:48:E0:7F"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- DIRECT LAN CONTROLLER SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="⚡ DIRECT LAN CONTROLLER (LOCAL WI-FI)"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Row 1: Ping & WOL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestPing"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:text="📡 PING HEALTH"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestWol"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#065F46"
                android:text="⚡ SEND WOL"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Lock & Unlock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestLock"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#1E3A8A"
                android:text="🔒 LOCK SCREEN"
                android:textColor="#93C5FD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestUnlock"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#0284C7"
                android:text="🔓 UNLOCK SESSION"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: Sleep & Restart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestSleep"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#312E81"
                android:text="🌙 SLEEP MODE"
                android:textColor="#C7D2FE"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestRestart"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#78350F"
                android:text="🔄 RESTART PC"
                android:textColor="#FDE68A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- DIAGNOSTIC CONSOLE LOG SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 REAL-TIME DIAGNOSTIC LOGS"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="CLEAR"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="#030712"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[READY] Nexus Satellite LAN Suite Initialized.\n"
                android:textColor="#10B981"
                android:textSize="9sp" />
        </ScrollView>

        <TextView
            android:id="@+id/tvFooterVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nexus Satellite • Direct LAN &amp; Cloud Gateway"
            android:textColor="#475569"
            android:textSize="9sp" />

    </LinearLayout>
</ScrollView>
